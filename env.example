# Environment Mode (sandbox or production)
SQUARE_ENVIRONMENT=sandbox

# Square API Credentials - SANDBOX (for testing)
SQUARE_SANDBOX_ACCESS_TOKEN=your_sandbox_access_token_here
SQUARE_SANDBOX_LOCATION_ID=your_sandbox_location_id_here
SQUARE_SANDBOX_APPLICATION_ID=your_sandbox_application_id_here

# Square API Credentials - PRODUCTION (for live transactions)
SQUARE_PRODUCTION_ACCESS_TOKEN=your_production_access_token_here
SQUARE_PRODUCTION_LOCATION_ID=your_production_location_id_here
SQUARE_PRODUCTION_APPLICATION_ID=your_production_application_id_here

# HubSpot API Credentials (for CRM integration)
# Use Personal Access Key (Development → Keys → Personal Access Key)
# OR HubSpot App static token (created with hs project create)
# See HUBSPOT_AUTH_MIGRATION.md for details
HUBSPOT_ACCESS_TOKEN=your_hubspot_access_token_here

# Magic Link Authentication
# Generate each secret with: openssl rand -hex 32
JWT_SECRET=generate_your_own_secret_here
MAGIC_LINK_SECRET=generate_your_own_secret_here
BASE_URL=https://www.rainydaymerchandise.com

# Email Service (for sending magic links)
# Get free API key at https://resend.com
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@rainydaymerchandise.com

